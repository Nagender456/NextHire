# ==============================================================================
# NextHire Backend — Render Environment Variables (Example Template)
# ==============================================================================
# Copy this template or use render.env to import into Render Web Service:
# Render Dashboard -> Environment -> "Add from .env"
# ==============================================================================

APP_NAME=NextHire API
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000

# Authentication & Session Security
SESSION_SECRET=replace-with-a-random-32-char-secret-string
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_TTL_SECONDS=604800

# Database Configuration (MongoDB Atlas)
REPOSITORY_BACKEND=mongo
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=nexthire

# CORS Configuration (Comma-separated allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://*.vercel.app

# System Observability & Rate Limiting
METRICS_ENABLED=true
INGESTION_ALERTING_ENABLED=true
RATE_LIMIT_BACKEND=memory
JOB_QUEUE_PATH=nexthire-jobs.sqlite3
